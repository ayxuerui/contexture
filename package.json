{
  "name": "ctxr-cli",
  "version": "0.4.1",
  "description": "A context store that ingests, organizes, and retrieves context for any AI agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayxuerui/contexture.git"
  },
  "homepage": "https://github.com/ayxuerui/contexture#readme",
  "bugs": {
    "url": "https://github.com/ayxuerui/contexture/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "ctxr": "./dist/bin.js",
    "contexture": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:phase0": "bash scripts/verify-phase0.sh"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "contexture",
    "context",
    "context-store",
    "ai-agents",
    "knowledge-base",
    "cli"
  ]
}
